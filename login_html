<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>ARKAN · دخول</title>
<meta name="theme-color" content="#0a0918">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='24' fill='%237c5cff'/><path d='M50 20 L74 78 H60 L50 52 L40 78 H26 Z' fill='%23fff'/></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=JetBrains+Mono:wght@400;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<style>
:root{
  --bg:#0a0918; --bg2:#12102a; --bg3:#1a1638; --panel:rgba(23,20,50,.66); --line:rgba(255,255,255,.08);
  --violet:#7c5cff; --violet-2:#a78bfa; --cyan:#22d3ee; --cyan-2:#67e8f9;
  --gold:#f5d76e; --gold-2:#d4a94a; --txt:#eef0ff; --mute:#9aa0c0; --dim:#6b7096;
  --up:#34d399; --down:#f87171; color-scheme:dark;
}
*{ box-sizing:border-box; }
body{
  margin:0; min-height:100dvh; color:var(--txt); font-family:'Tajawal',system-ui,sans-serif;
  display:grid; place-items:center; padding:22px;
  background:
    radial-gradient(60vw 50vw at 82% -8%, rgba(124,92,255,.30), transparent 62%),
    radial-gradient(50vw 44vw at 6% 10%, rgba(34,211,238,.18), transparent 64%),
    linear-gradient(180deg,#0a0918,#12102a 60%,#1a1638);
  background-attachment:fixed;
}
.mono{ font-family:'JetBrains Mono',monospace; direction:ltr; unicode-bidi:plaintext; }
.card{
  width:100%; max-width:420px; padding:1px; border-radius:26px;
  background:linear-gradient(160deg, rgba(245,215,110,.42), rgba(124,92,255,.28) 45%, transparent 78%);
}
.inner{ border-radius:25px; background:rgba(13,11,32,.9); backdrop-filter:blur(20px); padding:30px 24px; }
.logo{
  width:60px; height:60px; margin:0 auto; border-radius:18px; display:grid; place-items:center;
  background:linear-gradient(145deg,var(--violet),#4f46e5); color:#fff;
  font-family:'JetBrains Mono',monospace; font-weight:800; font-size:28px;
  box-shadow:0 0 0 1px rgba(255,255,255,.12), 0 16px 40px -12px rgba(124,92,255,.85);
}
h1{ margin:18px 0 3px; text-align:center; font-family:'JetBrains Mono',monospace; font-weight:800; font-size:22px; direction:ltr; }
h1 span{ color:var(--gold); }
.tag{ text-align:center; color:var(--dim); font-size:13px; margin-bottom:24px; }
.tabs{ display:flex; gap:6px; padding:5px; border-radius:14px; background:rgba(8,7,20,.6); border:1px solid var(--line); margin-bottom:20px; }
.tabs button{
  flex:1; padding:11px; border:0; border-radius:10px; cursor:pointer; background:transparent;
  color:var(--mute); font-family:'Tajawal',sans-serif; font-weight:700; font-size:14px; transition:.25s;
}
.tabs button.on{ background:var(--violet); color:#fff; }
.fld{ margin-bottom:14px; }
.fld label{ display:block; font-size:12px; color:var(--mute); margin-bottom:7px; }
.fld input{
  width:100%; background:rgba(8,7,20,.72); border:1px solid var(--line); border-radius:13px;
  padding:14px; color:var(--txt); font-size:15px; outline:0; transition:.25s;
}
.fld input:focus{ border-color:rgba(245,215,110,.45); }
.fld.name{ display:none; }
.btn{
  width:100%; margin-top:8px; padding:16px; border:0; border-radius:15px; cursor:pointer;
  background:linear-gradient(180deg,var(--gold),var(--gold-2)); color:#1a1400;
  font-family:'Tajawal',sans-serif; font-weight:800; font-size:16px; transition:.25s;
  box-shadow:0 14px 36px -16px rgba(245,215,110,.9);
}
.btn:hover{ filter:brightness(1.07); } .btn:disabled{ opacity:.55; }
.msg{ margin-top:16px; padding:12px 14px; border-radius:12px; font-size:13px; display:none; }
.msg.err{ display:block; background:rgba(248,113,113,.12); border:1px solid rgba(248,113,113,.3); color:#fca5a5; }
.msg.ok{ display:block; background:rgba(52,211,153,.12); border:1px solid rgba(52,211,153,.3); color:#6ee7b7; }
.foot{ margin-top:20px; text-align:center; font-size:12px; color:var(--dim); }
.foot a{ color:var(--cyan-2); text-decoration:none; }
:focus-visible{ outline:2px solid var(--gold); outline-offset:2px; }
</style>
</head>
<body>
<div class="card"><div class="inner">
  <div class="logo">A</div>
  <h1>ARKAN <span>SETTLEMENTS</span></h1>
  <p class="tag">بوابة العملاء — صرف · تحويل · تسوية</p>

  <div class="tabs">
    <button id="tabLogin" class="on">دخول</button>
    <button id="tabReg">حساب جديد</button>
  </div>

  <div class="fld name" id="nameFld">
    <label for="name">الاسم الكامل</label>
    <input id="name" type="text" autocomplete="name" placeholder="محمد الأمين">
  </div>
  <div class="fld">
    <label for="email">البريد الإلكتروني</label>
    <input id="email" type="email" inputmode="email" autocomplete="email" spellcheck="false" placeholder="you@example.com">
  </div>
  <div class="fld">
    <label for="pass">كلمة المرور</label>
    <input id="pass" type="password" autocomplete="current-password" placeholder="6 أحرف على الأقل">
  </div>
  <div class="fld name" id="phoneFld">
    <label for="phone">رقم الهاتف (واتساب)</label>
    <input id="phone" type="tel" inputmode="tel" placeholder="+222...">
  </div>

  <button class="btn" id="submitBtn">دخول</button>
  <div class="msg" id="msg"></div>

  <p class="foot">بالمتابعة أنت توافق على شروط خدمة أركان.</p>
</div></div>

<script type="module">
import {
  auth, db, ADMIN_EMAILS, onAuthStateChanged,
  createUserWithEmailAndPassword, signInWithEmailAndPassword,
  doc, getDoc, setDoc, serverTimestamp
} from './firebase-init.js';

const $ = id => document.getElementById(id);
let mode = 'login';

function setMode(m){
  mode = m;
  $('tabLogin').classList.toggle('on', m==='login');
  $('tabReg').classList.toggle('on', m==='reg');
  $('nameFld').style.display  = m==='reg' ? 'block' : 'none';
  $('phoneFld').style.display = m==='reg' ? 'block' : 'none';
  $('submitBtn').textContent  = m==='reg' ? 'إنشاء الحساب' : 'دخول';
  $('pass').autocomplete = m==='reg' ? 'new-password' : 'current-password';
  hideMsg();
}
$('tabLogin').onclick = () => setMode('login');
$('tabReg').onclick   = () => setMode('reg');

function showMsg(text, ok=false){ const m=$('msg'); m.textContent=text; m.className='msg '+(ok?'ok':'err'); }
function hideMsg(){ $('msg').className='msg'; }

// رقم مرجعي فريد للعميل
function makeRef(){ return 'AK' + Date.now().toString(36).toUpperCase().slice(-6); }

// توجيه بعد الدخول
function route(user){
  const isAdmin = ADMIN_EMAILS.includes((user.email||'').toLowerCase()) ||
                  ADMIN_EMAILS.includes(user.email||'');
  location.href = isAdmin ? 'admin.html' : 'dashboard.html';
}

// إن كان مسجّلاً مسبقاً
onAuthStateChanged(auth, user => { if (user) route(user); });

$('submitBtn').onclick = async () => {
  const email = $('email').value.trim();
  const pass  = $('pass').value;
  if (!email || !pass){ showMsg('أدخل البريد وكلمة المرور'); return; }
  if (pass.length < 6){ showMsg('كلمة المرور 6 أحرف على الأقل'); return; }

  $('submitBtn').disabled = true;
  const orig = $('submitBtn').textContent;
  $('submitBtn').textContent = '...';

  try {
    if (mode === 'reg'){
      const name  = $('name').value.trim();
      const phone = $('phone').value.trim();
      if (!name){ showMsg('أدخل اسمك الكامل'); throw 'stop'; }
      const cred = await createUserWithEmailAndPassword(auth, email, pass);
      // ملف العميل في Firestore
      await setDoc(doc(db, 'users', cred.user.uid), {
        name, email, phone,
        ref: makeRef(),
        balance: 0,
        role: 'client',
        createdAt: serverTimestamp()
      });
      showMsg('تم إنشاء حسابك بنجاح', true);
      setTimeout(() => route(cred.user), 700);
    } else {
      const cred = await signInWithEmailAndPassword(auth, email, pass);
      route(cred.user);
    }
  } catch (e) {
    if (e === 'stop'){ /* رسالة معروضة */ }
    else {
      const map = {
        'auth/invalid-credential':'بريد أو كلمة مرور غير صحيحة',
        'auth/user-not-found':'لا يوجد حساب بهذا البريد',
        'auth/wrong-password':'كلمة المرور غير صحيحة',
        'auth/email-already-in-use':'هذا البريد مسجّل مسبقاً — سجّل الدخول',
        'auth/invalid-email':'صيغة البريد غير صحيحة',
        'auth/too-many-requests':'محاولات كثيرة — انتظر قليلاً',
        'auth/network-request-failed':'تحقق من اتصالك بالإنترنت'
      };
      showMsg(map[e.code] || ('خطأ: ' + (e.message || e)));
    }
  } finally {
    $('submitBtn').disabled = false;
    $('submitBtn').textContent = orig;
  }
};

// Enter للإرسال
['email','pass','name','phone'].forEach(id =>
  $(id).addEventListener('keydown', e => { if (e.key==='Enter') $('submitBtn').click(); })
);
</script>
</body>
</html>
